{
  "name": "math-mistake-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "面向六年级学生的数学错题诊断与掌握练习 MVP",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "backup": "node scripts/backup-learning-data.mjs",
    "backup:db": "node scripts/backup-database.mjs",
    "restore": "node scripts/restore-learning-data.mjs",
    "deploy:remote": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-remote.ps1",
    "evaluate:knowledge": "node scripts/evaluate-m5-knowledge.js",
    "evaluate:m7": "node scripts/evaluate-m7.js"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
