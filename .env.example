LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=replace-with-a-compatible-model
LLM_PROVIDER=openai-compatible
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_INPUT_CHARS=24000
LLM_RATE_LIMIT_PER_MINUTE=0
LLM_TEMPERATURE=0.2
LLM_STREAM=false

# 可选：图片文字识别（OpenAI-compatible vision）
# 未配置 VISION_MODEL 时识别不可用，不影响手工文字 + 图片录题。
# VISION_BASE_URL 默认回退 LLM_BASE_URL，VISION_API_KEY 默认回退 LLM_API_KEY。
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_API_KEY=replace-with-your-api-key
# VISION_MODEL=
# VISION_PROVIDER=openai-compatible
# VISION_TIMEOUT_MS=30000

# 可选：图片附件目录与完整备份目录
# 默认分别是 DB_PATH 同级的 attachments/ 和 backups/。
# ATTACHMENTS_DIR=
# BACKUP_DIR=

# Docker 部署时由 docker-compose.yml 读取；本地 node 启动会忽略这些变量
# DATA_DIR=/srv/math-coach-data
# APP_PORT=3000
# BIND_ADDRESS=127.0.0.1
# IMAGE_TAG=0.9
# APP_UID=1000
# APP_GID=1000
